{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cardamoi",
  "version": "0.2.0",
  "identifier": "com.cardamoi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Cardamoi",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0ODg5MkNGQUZDMEJCRjMKUldUenU4Q3Z6NUtJdE9ncER1elB3RlQ2Zyt6dk5CRWd3cjdvS2FyZ1lLSnViRmZ0ZTZocjhpZ1YK",
      "endpoints": [
        "https://github.com/wlaith/cardamoi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/prowlarr/": "prowlarr/",
      "vendor/mpv/": "mpv/"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}